# ========================================================
# CuraPulse AI - Environment Configuration Template
# Copy this file to '.env' and fill in your credentials.
# ========================================================

# LLM API Key (Google Gemini) - Required
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: comma-separated browser origins allowed by the Python API
FRONTEND_ORIGINS=http://localhost:3000

# Embedding provider: 'local' or 'gemini' (Gemini API free-tier quotas apply)
EMBEDDING_PROVIDER=local
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CHROMA_PERSIST_DIR=vectorstore

# Vector Store Selection: 'chroma' (local, zero-cost, no account needed) or 'pinecone' (cloud)
VECTOR_STORE_TYPE=chroma

# Pinecone Credentials (Only required if VECTOR_STORE_TYPE=pinecone)
# Get your free key at: https://www.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=curapulse-medical

# Optional: HuggingFace token (not used by the Gemini/local embedding providers)
HUGGINGFACE_KEY=
